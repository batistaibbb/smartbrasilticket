# ============================================
# Smart Brasil Ticket — Secrets das Edge Functions (Supabase)
# Copie para supabase/.env.local OU use `supabase secrets set` (recomendado)
# NUNCA faça commit deste arquivo com valores reais
# ============================================

# Resend.com — chave da API (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Remetente verificado no domínio do Resend (Domains)
FROM_EMAIL=Smart Brasil Ticket <contato@smartbrasilticket.com.br>

# URL pública do app (usada nos links "Ver Comprovante" dos emails)
APP_BASE_URL=https://seu-app.vercel.app

# Mercado Pago (já usados pelas functions de pagamento)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase (preenchidos automaticamente no deploy gerenciado;
# necessários apenas para testes locais com `supabase functions serve`)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
